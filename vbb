<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Via Bebê – Loja Infantil em Planaltina DF | Enxoval, Roupas e Acessórios para Bebê</title>
  <meta name="description" content="Via Bebê é a loja infantil completa em Planaltina-DF. Encontre enxoval, roupinhas, mamadeiras, carrinhos e muito mais para o seu bebê. Atendimento pelo WhatsApp!" />
  <meta name="keywords" content="loja de bebê Planaltina DF, enxoval de bebê Planaltina, roupas infantis Planaltina, loja infantil DF, Via Bebê" />
  <meta property="og:title" content="Via Bebê – Loja Infantil em Planaltina DF" />
  <meta property="og:description" content="Tudo para o seu bebê em um só lugar. Enxoval, roupinhas, acessórios e muito mais em Planaltina-DF." />
  <meta property="og:type" content="website" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,300&display=swap" rel="stylesheet" />

  <style>
    :root {
      --cream: #fdf9f5;
      --blush: #f7e8e3;
      --rose: #e8b4b8;
      --rose-deep: #c9848a;
      --rose-text: #9e5a62;
      --sky: #dceef7;
      --sky-mid: #a8d4e9;
      --sky-deep: #6aa8c9;
      --sage: #d4e6d4;
      --sand: #f0e6d8;
      --sand-mid: #d4b896;
      --brown-soft: #8c6e56;
      --white: #ffffff;
      --text-dark: #3a2e28;
      --text-mid: #7a6456;
      --text-light: #b09a8c;
      --shadow-sm: 0 2px 12px rgba(180,130,110,0.10);
      --shadow-md: 0 8px 32px rgba(180,130,110,0.14);
      --shadow-lg: 0 20px 60px rgba(180,130,110,0.18);
      --radius-sm: 12px;
      --radius-md: 20px;
      --radius-lg: 32px;
      --radius-xl: 48px;
      --whatsapp: #25D366;
      --whatsapp-dark: #1da851;
      --font-display: 'Cormorant Garamond', Georgia, serif;
      --font-body: 'DM Sans', sans-serif;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; font-size: 16px; }

    body {
      font-family: var(--font-body);
      background: var(--cream);
      color: var(--text-dark);
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    /* ── SCROLL ANIMATIONS ── */
    .reveal {
      opacity: 0;
      transform: translateY(32px);
      transition: opacity 0.7s cubic-bezier(.22,.68,0,1.2), transform 0.7s cubic-bezier(.22,.68,0,1.2);
    }
    .reveal.visible { opacity: 1; transform: none; }
    .reveal-delay-1 { transition-delay: 0.1s; }
    .reveal-delay-2 { transition-delay: 0.2s; }
    .reveal-delay-3 { transition-delay: 0.3s; }
    .reveal-delay-4 { transition-delay: 0.4s; }
    .reveal-delay-5 { transition-delay: 0.5s; }

    /* ── HEADER ── */
    header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(253,249,245,0.92);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid rgba(232,180,184,0.25);
      transition: box-shadow 0.3s;
    }
    header.scrolled { box-shadow: var(--shadow-sm); }

    .header-inner {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 24px;
      height: 72px;
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      flex-shrink: 0;
    }
    .logo-icon {
      width: 40px;
      height: 40px;
      background: linear-gradient(135deg, var(--rose), var(--sky-mid));
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
    }
    .logo-text {
      display: flex;
      flex-direction: column;
      line-height: 1;
    }
    .logo-via {
      font-family: var(--font-body);
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.18em;
      color: var(--text-light);
      text-transform: uppercase;
    }
    .logo-bebe {
      font-family: var(--font-display);
      font-size: 22px;
      font-weight: 600;
      color: var(--rose-text);
      letter-spacing: 0.02em;
    }

    /* Search */
    .search-wrap {
      flex: 1;
      max-width: 420px;
      position: relative;
    }
    .search-input {
      width: 100%;
      padding: 10px 16px 10px 40px;
      background: var(--sand);
      border: 1.5px solid transparent;
      border-radius: 999px;
      font-family: var(--font-body);
      font-size: 14px;
      color: var(--text-dark);
      outline: none;
      transition: border-color 0.2s, background 0.2s;
    }
    .search-input::placeholder { color: var(--text-light); }
    .search-input:focus { background: var(--white); border-color: var(--rose); }
    .search-icon {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-light);
      pointer-events: none;
      font-size: 15px;
    }
    .search-results-dropdown {
      position: absolute;
      top: calc(100% + 8px);
      left: 0;
      right: 0;
      background: var(--white);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-lg);
      max-height: 360px;
      overflow-y: auto;
      z-index: 2000;
      display: none;
    }
    .search-results-dropdown.active { display: block; }
    .search-result-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 16px;
      cursor: pointer;
      transition: background 0.15s;
      border-bottom: 1px solid var(--sand);
    }
    .search-result-item:last-child { border-bottom: none; }
    .search-result-item:hover { background: var(--cream); }
    .search-result-img {
      width: 44px;
      height: 44px;
      border-radius: var(--radius-sm);
      object-fit: cover;
      background: var(--sand);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      flex-shrink: 0;
    }
    .search-result-name { font-size: 13px; font-weight: 500; color: var(--text-dark); }
    .search-result-price { font-size: 12px; color: var(--rose-text); font-weight: 600; margin-top: 2px; }

    /* Nav */
    nav.desktop-nav {
      display: flex;
      align-items: center;
      gap: 4px;
      margin-left: auto;
    }
    nav.desktop-nav a {
      padding: 8px 14px;
      font-size: 14px;
      font-weight: 500;
      color: var(--text-mid);
      text-decoration: none;
      border-radius: 999px;
      transition: background 0.2s, color 0.2s;
    }
    nav.desktop-nav a:hover { background: var(--blush); color: var(--rose-text); }

    .btn-whatsapp-header {
      display: flex;
      align-items: center;
      gap: 7px;
      padding: 9px 18px;
      background: var(--whatsapp);
      color: white;
      border: none;
      border-radius: 999px;
      font-family: var(--font-body);
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      transition: background 0.2s, transform 0.15s;
      flex-shrink: 0;
    }
    .btn-whatsapp-header:hover { background: var(--whatsapp-dark); transform: scale(1.04); }

    /* Hamburger */
    .hamburger {
      display: none;
      flex-direction: column;
      gap: 5px;
      cursor: pointer;
      padding: 8px;
      margin-left: auto;
      background: none;
      border: none;
    }
    .hamburger span {
      display: block;
      width: 22px;
      height: 2px;
      background: var(--rose-text);
      border-radius: 2px;
      transition: transform 0.3s, opacity 0.3s;
    }
    .hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .hamburger.open span:nth-child(2) { opacity: 0; }
    .hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    /* Mobile menu */
    .mobile-menu {
      display: none;
      position: fixed;
      inset: 0;
      top: 72px;
      background: rgba(253,249,245,0.98);
      z-index: 999;
      padding: 32px 24px;
      flex-direction: column;
      gap: 4px;
      overflow-y: auto;
      transform: translateX(100%);
      transition: transform 0.35s cubic-bezier(.22,.68,0,1.2);
    }
    .mobile-menu.open { transform: translateX(0); }
    .mobile-menu a {
      display: block;
      padding: 16px 20px;
      font-size: 18px;
      font-weight: 500;
      color: var(--text-dark);
      text-decoration: none;
      border-radius: var(--radius-md);
      transition: background 0.2s;
    }
    .mobile-menu a:hover { background: var(--blush); color: var(--rose-text); }
    .mobile-menu-cats { margin-top: 16px; }
    .mobile-menu-cats-title {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--text-light);
      padding: 8px 20px 4px;
    }
    .mobile-menu-wa {
      margin-top: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 16px;
      background: var(--whatsapp);
      color: white;
      border-radius: var(--radius-md);
      font-weight: 600;
      font-size: 16px;
      text-decoration: none;
    }

    /* ── HERO ── */
    .hero {
      min-height: 88vh;
      display: flex;
      align-items: center;
      position: relative;
      overflow: hidden;
      background: linear-gradient(135deg, var(--blush) 0%, var(--cream) 45%, var(--sky) 100%);
      padding: 80px 24px 60px;
    }

    .hero-bg-orbs {
      position: absolute;
      inset: 0;
      pointer-events: none;
      overflow: hidden;
    }
    .orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(60px);
      opacity: 0.45;
    }
    .orb-1 { width: 500px; height: 500px; background: var(--rose); top: -120px; left: -100px; animation: floatOrb 8s ease-in-out infinite; }
    .orb-2 { width: 380px; height: 380px; background: var(--sky-mid); bottom: -80px; right: -60px; animation: floatOrb 10s ease-in-out infinite reverse; }
    .orb-3 { width: 260px; height: 260px; background: var(--sage); top: 30%; left: 40%; animation: floatOrb 12s ease-in-out infinite 2s; }

    @keyframes floatOrb {
      0%, 100% { transform: translate(0, 0) scale(1); }
      33% { transform: translate(20px, -30px) scale(1.05); }
      66% { transform: translate(-15px, 20px) scale(0.97); }
    }

    .hero-inner {
      max-width: 1280px;
      margin: 0 auto;
      width: 100%;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: center;
      position: relative;
      z-index: 1;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 7px 16px;
      background: white;
      border-radius: 999px;
      box-shadow: var(--shadow-sm);
      font-size: 13px;
      font-weight: 500;
      color: var(--rose-text);
      margin-bottom: 24px;
      width: fit-content;
    }
    .hero-badge-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--whatsapp);
      animation: pulse 2s ease-in-out infinite;
    }
    @keyframes pulse {
      0%, 100% { transform: scale(1); opacity: 1; }
      50% { transform: scale(1.5); opacity: 0.6; }
    }

    .hero-title {
      font-family: var(--font-display);
      font-size: clamp(38px, 6vw, 68px);
      font-weight: 500;
      line-height: 1.1;
      color: var(--text-dark);
      margin-bottom: 20px;
    }
    .hero-title em {
      font-style: italic;
      color: var(--rose-text);
    }

    .hero-sub {
      font-size: 17px;
      line-height: 1.65;
      color: var(--text-mid);
      max-width: 440px;
      margin-bottom: 36px;
    }

    .hero-ctas {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
    }

    .btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 14px 28px;
      background: var(--rose-text);
      color: white;
      border: none;
      border-radius: 999px;
      font-family: var(--font-body);
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
      box-shadow: 0 4px 20px rgba(158,90,98,0.3);
    }
    .btn-primary:hover { background: #8a4a52; transform: translateY(-2px); box-shadow: 0 8px 28px rgba(158,90,98,0.38); }

    .btn-whatsapp-large {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 14px 28px;
      background: var(--whatsapp);
      color: white;
      border: none;
      border-radius: 999px;
      font-family: var(--font-body);
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
      box-shadow: 0 4px 20px rgba(37,211,102,0.3);
    }
    .btn-whatsapp-large:hover { background: var(--whatsapp-dark); transform: translateY(-2px); box-shadow: 0 8px 28px rgba(37,211,102,0.38); }

    .hero-stats {
      display: flex;
      gap: 32px;
      margin-top: 44px;
    }
    .hero-stat { }
    .hero-stat-num {
      font-family: var(--font-display);
      font-size: 28px;
      font-weight: 600;
      color: var(--rose-text);
    }
    .hero-stat-label {
      font-size: 12px;
      color: var(--text-light);
      font-weight: 500;
    }

    /* Hero visual */
    .hero-visual {
      position: relative;
      display: flex;
      justify-content: center;
      align-items: center;
    }
    .hero-card-stack {
      position: relative;
      width: 360px;
      height: 420px;
    }
    .hero-card {
      position: absolute;
      background: white;
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-md);
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 80px;
    }
    .hero-card-main {
      width: 280px;
      height: 340px;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      background: linear-gradient(145deg, var(--blush), var(--sky));
      z-index: 3;
      animation: heroCardFloat 6s ease-in-out infinite;
    }
    @keyframes heroCardFloat {
      0%, 100% { transform: translate(-50%, -50%) rotate(-2deg); }
      50% { transform: translate(-50%, -54%) rotate(1deg); }
    }
    .hero-card-bg1 {
      width: 220px;
      height: 260px;
      top: 10px;
      right: 10px;
      background: linear-gradient(145deg, var(--sky), var(--sage));
      z-index: 2;
      transform: rotate(8deg);
      font-size: 60px;
    }
    .hero-card-bg2 {
      width: 200px;
      height: 240px;
      bottom: 10px;
      left: 10px;
      background: linear-gradient(145deg, var(--sand), var(--rose));
      z-index: 1;
      transform: rotate(-10deg);
      font-size: 55px;
    }

    .hero-floating-tag {
      position: absolute;
      background: white;
      border-radius: var(--radius-sm);
      box-shadow: var(--shadow-md);
      padding: 10px 16px;
      font-size: 13px;
      font-weight: 600;
      color: var(--text-dark);
      z-index: 10;
      white-space: nowrap;
    }
    .hero-floating-tag.tag-1 {
      top: 10%;
      right: -10px;
      animation: tagFloat 5s ease-in-out infinite;
    }
    .hero-floating-tag.tag-2 {
      bottom: 15%;
      left: -20px;
      animation: tagFloat 7s ease-in-out infinite reverse;
    }
    @keyframes tagFloat {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-10px); }
    }

    /* ── SECTION COMMON ── */
    section { padding: 80px 24px; }
    .section-inner { max-width: 1280px; margin: 0 auto; }

    .section-header {
      text-align: center;
      margin-bottom: 52px;
    }
    .section-tag {
      display: inline-block;
      padding: 5px 16px;
      background: var(--blush);
      color: var(--rose-text);
      border-radius: 999px;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      margin-bottom: 14px;
    }
    .section-title {
      font-family: var(--font-display);
      font-size: clamp(28px, 4vw, 44px);
      font-weight: 500;
      color: var(--text-dark);
      line-height: 1.15;
    }
    .section-title em { font-style: italic; color: var(--rose-text); }
    .section-sub {
      font-size: 16px;
      color: var(--text-mid);
      margin-top: 10px;
      line-height: 1.6;
    }

    /* ── PROMO BANNER ── */
    .promo-section { background: var(--blush); padding: 0; }
    .promo-inner {
      max-width: 1280px;
      margin: 0 auto;
      padding: 56px 24px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
    .promo-card {
      border-radius: var(--radius-lg);
      padding: 40px;
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      min-height: 280px;
      cursor: pointer;
      transition: transform 0.3s;
    }
    .promo-card:hover { transform: scale(1.02); }
    .promo-card-1 { background: linear-gradient(135deg, #e8c4d4 0%, #f0d8e4 100%); }
    .promo-card-2 { background: linear-gradient(135deg, #c4dce8 0%, #d8eef8 100%); }
    .promo-emoji {
      position: absolute;
      top: -10px;
      right: -10px;
      font-size: 100px;
      opacity: 0.25;
      transform: rotate(-15deg);
    }
    .promo-tag-pill {
      display: inline-block;
      padding: 5px 14px;
      background: white;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
      color: var(--rose-text);
      margin-bottom: 12px;
      width: fit-content;
    }
    .promo-card-title {
      font-family: var(--font-display);
      font-size: 28px;
      font-weight: 600;
      color: var(--text-dark);
      line-height: 1.2;
      margin-bottom: 8px;
    }
    .promo-card-sub { font-size: 14px; color: var(--text-mid); margin-bottom: 20px; }
    .btn-outline-rose {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 22px;
      border: 2px solid var(--rose-text);
      color: var(--rose-text);
      background: white;
      border-radius: 999px;
      font-family: var(--font-body);
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      width: fit-content;
      transition: background 0.2s, color 0.2s;
    }
    .btn-outline-rose:hover { background: var(--rose-text); color: white; }

    /* ── CATEGORIES ── */
    .categories-section { background: var(--cream); }
    .categories-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      gap: 16px;
    }
    .cat-card {
      background: white;
      border-radius: var(--radius-md);
      padding: 24px 16px;
      text-align: center;
      cursor: pointer;
      transition: transform 0.25s, box-shadow 0.25s, background 0.25s;
      box-shadow: var(--shadow-sm);
      text-decoration: none;
      display: block;
    }
    .cat-card:hover {
      transform: translateY(-6px);
      box-shadow: var(--shadow-md);
      background: var(--blush);
    }
    .cat-icon { font-size: 36px; margin-bottom: 12px; display: block; }
    .cat-name {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-dark);
    }
    .cat-count {
      font-size: 11px;
      color: var(--text-light);
      margin-top: 4px;
    }

    /* ── PRODUCTS GRID ── */
    .products-section { background: var(--sand); }
    .products-filter-bar {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-bottom: 36px;
    }
    .filter-btn {
      padding: 8px 20px;
      border: 1.5px solid var(--rose);
      background: white;
      border-radius: 999px;
      font-family: var(--font-body);
      font-size: 13px;
      font-weight: 500;
      color: var(--text-mid);
      cursor: pointer;
      transition: all 0.2s;
    }
    .filter-btn:hover, .filter-btn.active {
      background: var(--rose-text);
      border-color: var(--rose-text);
      color: white;
    }

    .products-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 24px;
    }

    /* Product card */
    .product-card {
      background: white;
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
      transition: transform 0.3s, box-shadow 0.3s;
      cursor: pointer;
      position: relative;
    }
    .product-card:hover { transform: translateY(-8px); box-shadow: var(--shadow-md); }

    .product-img-wrap {
      position: relative;
      height: 240px;
      overflow: hidden;
      background: var(--sand);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 80px;
    }
    .product-img-wrap::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 60px;
      background: linear-gradient(to top, rgba(255,255,255,0.5), transparent);
    }

    .product-badge {
      position: absolute;
      top: 14px;
      left: 14px;
      padding: 4px 12px;
      background: var(--rose-text);
      color: white;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.05em;
      z-index: 2;
    }
    .product-badge.promo { background: #e07a3a; }
    .product-badge.novo { background: var(--sky-deep); }

    .product-info { padding: 20px; }
    .product-cat {
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--text-light);
      margin-bottom: 6px;
    }
    .product-name {
      font-family: var(--font-display);
      font-size: 19px;
      font-weight: 600;
      color: var(--text-dark);
      line-height: 1.25;
      margin-bottom: 6px;
    }
    .product-desc {
      font-size: 13px;
      color: var(--text-mid);
      line-height: 1.5;
      margin-bottom: 16px;
    }
    .product-price-row {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 16px;
    }
    .product-price {
      font-family: var(--font-display);
      font-size: 22px;
      font-weight: 600;
      color: var(--rose-text);
    }
    .product-price-old {
      font-size: 14px;
      color: var(--text-light);
      text-decoration: line-through;
    }
    .btn-wa-card {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      padding: 12px;
      background: var(--whatsapp);
      color: white;
      border: none;
      border-radius: var(--radius-sm);
      font-family: var(--font-body);
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      transition: background 0.2s, transform 0.15s;
    }
    .btn-wa-card:hover { background: var(--whatsapp-dark); transform: scale(1.02); }

    /* ── DIFERENCIAIS ── */
    .diferenciais-section { background: var(--cream); }
    .diferenciais-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 24px;
    }
    .diferencial-card {
      background: white;
      border-radius: var(--radius-md);
      padding: 32px 24px;
      box-shadow: var(--shadow-sm);
      transition: transform 0.25s, box-shadow 0.25s;
    }
    .diferencial-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
    .diferencial-icon {
      width: 52px;
      height: 52px;
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 26px;
      margin-bottom: 18px;
    }
    .diferencial-icon.rose { background: var(--blush); }
    .diferencial-icon.sky { background: var(--sky); }
    .diferencial-icon.sage { background: var(--sage); }
    .diferencial-icon.sand { background: var(--sand); }
    .diferencial-title {
      font-family: var(--font-display);
      font-size: 18px;
      font-weight: 600;
      color: var(--text-dark);
      margin-bottom: 8px;
    }
    .diferencial-desc { font-size: 14px; color: var(--text-mid); line-height: 1.55; }

    /* ── DEPOIMENTOS ── */
    .depoimentos-section { background: var(--blush); }
    .depoimentos-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 24px;
    }
    .depoimento-card {
      background: white;
      border-radius: var(--radius-md);
      padding: 28px;
      box-shadow: var(--shadow-sm);
    }
    .stars { color: #f59e0b; font-size: 16px; margin-bottom: 14px; letter-spacing: 2px; }
    .depoimento-text {
      font-size: 15px;
      color: var(--text-mid);
      line-height: 1.65;
      font-style: italic;
      margin-bottom: 20px;
    }
    .depoimento-autor {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .depoimento-avatar {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      background: var(--sand);
    }
    .depoimento-nome { font-size: 14px; font-weight: 600; color: var(--text-dark); }
    .depoimento-local { font-size: 12px; color: var(--text-light); }

    /* ── CTA WHATSAPP ── */
    .cta-section {
      background: linear-gradient(135deg, var(--rose-text) 0%, #7a3a42 100%);
      color: white;
      text-align: center;
      padding: 80px 24px;
    }
    .cta-inner { max-width: 600px; margin: 0 auto; }
    .cta-emoji { font-size: 56px; margin-bottom: 20px; display: block; }
    .cta-title {
      font-family: var(--font-display);
      font-size: clamp(28px, 4vw, 44px);
      font-weight: 500;
      margin-bottom: 14px;
      line-height: 1.15;
    }
    .cta-sub { font-size: 16px; opacity: 0.85; margin-bottom: 32px; line-height: 1.6; }
    .btn-wa-cta {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 16px 36px;
      background: var(--whatsapp);
      color: white;
      border: none;
      border-radius: 999px;
      font-family: var(--font-body);
      font-size: 16px;
      font-weight: 700;
      cursor: pointer;
      text-decoration: none;
      transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
      box-shadow: 0 8px 28px rgba(37,211,102,0.4);
    }
    .btn-wa-cta:hover { background: var(--whatsapp-dark); transform: scale(1.05); }

    /* ── FOOTER ── */
    footer {
      background: var(--text-dark);
      color: rgba(255,255,255,0.8);
      padding: 64px 24px 32px;
    }
    .footer-inner {
      max-width: 1280px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1.5fr 1fr 1fr 1fr;
      gap: 48px;
      padding-bottom: 48px;
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }
    .footer-brand .logo-via { color: rgba(255,255,255,0.5); }
    .footer-brand .logo-bebe { color: var(--rose); }
    .footer-desc {
      font-size: 14px;
      line-height: 1.65;
      color: rgba(255,255,255,0.55);
      margin-top: 16px;
      max-width: 260px;
    }
    .footer-wa-btn {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 11px 20px;
      background: var(--whatsapp);
      color: white;
      border-radius: 999px;
      font-size: 13px;
      font-weight: 600;
      text-decoration: none;
      margin-top: 20px;
      width: fit-content;
      transition: background 0.2s;
    }
    .footer-wa-btn:hover { background: var(--whatsapp-dark); }
    .footer-col-title {
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.35);
      margin-bottom: 20px;
    }
    .footer-col a {
      display: block;
      font-size: 14px;
      color: rgba(255,255,255,0.65);
      text-decoration: none;
      margin-bottom: 10px;
      transition: color 0.2s;
    }
    .footer-col a:hover { color: white; }
    .footer-col p {
      font-size: 14px;
      color: rgba(255,255,255,0.65);
      margin-bottom: 10px;
      line-height: 1.5;
    }
    .footer-bottom {
      max-width: 1280px;
      margin: 0 auto;
      padding-top: 28px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 13px;
      color: rgba(255,255,255,0.35);
      flex-wrap: wrap;
      gap: 12px;
    }

    /* ── FLOATING WA BUTTON ── */
    .floating-wa {
      position: fixed;
      bottom: 28px;
      right: 28px;
      width: 60px;
      height: 60px;
      background: var(--whatsapp);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 8px 24px rgba(37,211,102,0.5);
      z-index: 2000;
      text-decoration: none;
      transition: transform 0.25s, box-shadow 0.25s;
      animation: waPop 0.5s 1.5s cubic-bezier(.22,.68,0,1.5) both;
    }
    .floating-wa:hover { transform: scale(1.12); box-shadow: 0 12px 36px rgba(37,211,102,0.6); }
    @keyframes waPop {
      from { transform: scale(0); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }
    .floating-wa svg { width: 30px; height: 30px; fill: white; }
    .floating-wa-pulse {
      position: absolute;
      width: 100%;
      height: 100%;
      border-radius: 50%;
      background: var(--whatsapp);
      animation: waPulse 2.5s ease-out infinite;
      z-index: -1;
    }
    @keyframes waPulse {
      0% { transform: scale(1); opacity: 0.6; }
      100% { transform: scale(1.9); opacity: 0; }
    }

    /* ── MODAL PRODUTO ── */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(40,24,18,0.6);
      z-index: 3000;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s;
      padding: 0;
    }
    .modal-overlay.open { opacity: 1; pointer-events: all; }
    .modal-content {
      background: white;
      border-radius: var(--radius-xl) var(--radius-xl) 0 0;
      max-width: 640px;
      width: 100%;
      max-height: 92vh;
      overflow-y: auto;
      padding: 40px 32px 40px;
      transform: translateY(100%);
      transition: transform 0.4s cubic-bezier(.22,.68,0,1.2);
      position: relative;
    }
    .modal-overlay.open .modal-content { transform: translateY(0); }
    .modal-close {
      position: absolute;
      top: 20px;
      right: 20px;
      width: 36px;
      height: 36px;
      background: var(--sand);
      border: none;
      border-radius: 50%;
      font-size: 18px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-mid);
      transition: background 0.2s;
    }
    .modal-close:hover { background: var(--blush); }
    .modal-handle {
      width: 40px;
      height: 4px;
      background: var(--sand-mid);
      border-radius: 2px;
      margin: 0 auto 28px;
    }
    .modal-emoji { font-size: 72px; text-align: center; display: block; margin-bottom: 20px; }
    .modal-badge { }
    .modal-cat {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--text-light);
      margin-bottom: 8px;
    }
    .modal-name {
      font-family: var(--font-display);
      font-size: 28px;
      font-weight: 600;
      color: var(--text-dark);
      margin-bottom: 12px;
      line-height: 1.2;
    }
    .modal-desc { font-size: 15px; color: var(--text-mid); line-height: 1.65; margin-bottom: 24px; }
    .modal-price-row { display: flex; align-items: center; gap: 12px; margin-bottom: 28px; }
    .modal-price {
      font-family: var(--font-display);
      font-size: 30px;
      font-weight: 600;
      color: var(--rose-text);
    }
    .modal-price-old {
      font-size: 16px;
      color: var(--text-light);
      text-decoration: line-through;
    }
    .btn-wa-modal {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      padding: 16px;
      background: var(--whatsapp);
      color: white;
      border: none;
      border-radius: var(--radius-md);
      font-family: var(--font-body);
      font-size: 16px;
      font-weight: 700;
      cursor: pointer;
      text-decoration: none;
      transition: background 0.2s, transform 0.15s;
      box-shadow: 0 4px 20px rgba(37,211,102,0.35);
    }
    .btn-wa-modal:hover { background: var(--whatsapp-dark); transform: scale(1.02); }

    /* ── NOVIDADES STRIP ── */
    .novidades-section { background: var(--sky); }
    .novidades-scroll {
      display: flex;
      gap: 20px;
      overflow-x: auto;
      padding-bottom: 8px;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
    }
    .novidades-scroll::-webkit-scrollbar { height: 4px; }
    .novidades-scroll::-webkit-scrollbar-track { background: rgba(0,0,0,0.05); border-radius: 2px; }
    .novidades-scroll::-webkit-scrollbar-thumb { background: var(--sky-mid); border-radius: 2px; }
    .novidade-card {
      flex-shrink: 0;
      width: 200px;
      background: white;
      border-radius: var(--radius-md);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
      scroll-snap-align: start;
      cursor: pointer;
      transition: transform 0.25s;
    }
    .novidade-card:hover { transform: scale(1.04); }
    .novidade-img {
      height: 150px;
      background: var(--sand);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 56px;
    }
    .novidade-info { padding: 14px; }
    .novidade-name { font-size: 13px; font-weight: 600; color: var(--text-dark); margin-bottom: 4px; }
    .novidade-price { font-size: 14px; color: var(--rose-text); font-weight: 700; }

    /* ── MAIS VENDIDOS ── */
    .mais-vendidos-section { background: var(--cream); }
    .mais-vendidos-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 20px;
    }
    .mv-card {
      background: white;
      border-radius: var(--radius-md);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
      cursor: pointer;
      transition: transform 0.25s, box-shadow 0.25s;
      position: relative;
    }
    .mv-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-md); }
    .mv-rank {
      position: absolute;
      top: 10px;
      left: 10px;
      width: 28px;
      height: 28px;
      background: var(--rose-text);
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: 700;
      z-index: 2;
    }
    .mv-img {
      height: 160px;
      background: var(--sand);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 58px;
    }
    .mv-info { padding: 14px; }
    .mv-name { font-size: 13px; font-weight: 600; color: var(--text-dark); margin-bottom: 6px; }
    .mv-price { font-size: 15px; color: var(--rose-text); font-weight: 700; }

    /* ── RESPONSIVE ── */
    @media (max-width: 900px) {
      .hero-inner { grid-template-columns: 1fr; gap: 40px; }
      .hero-visual { display: none; }
      .hero-ctas { flex-direction: column; }
      .promo-inner { grid-template-columns: 1fr; }
      .footer-inner { grid-template-columns: 1fr 1fr; gap: 32px; }
    }

    @media (max-width: 640px) {
      .search-wrap { display: none; }
      nav.desktop-nav { display: none; }
      .btn-whatsapp-header { display: none; }
      .hamburger { display: flex; }
      .mobile-menu { display: flex; }
      .hero { padding: 48px 20px 48px; min-height: 80vh; }
      section { padding: 56px 20px; }
      .categories-grid { grid-template-columns: repeat(3, 1fr); gap: 12px; }
      .cat-card { padding: 18px 10px; }
      .cat-icon { font-size: 28px; margin-bottom: 8px; }
      .products-grid { grid-template-columns: 1fr 1fr; gap: 14px; }
      .product-img-wrap { height: 180px; font-size: 58px; }
      .product-name { font-size: 15px; }
      .product-info { padding: 14px; }
      .diferenciais-grid { grid-template-columns: 1fr 1fr; }
      .depoimentos-grid { grid-template-columns: 1fr; }
      .mais-vendidos-grid { grid-template-columns: repeat(2, 1fr); }
      .footer-inner { grid-template-columns: 1fr; gap: 24px; }
      .footer-bottom { flex-direction: column; text-align: center; }
      .hero-stats { gap: 20px; }
      .modal-content { padding: 32px 20px 32px; border-radius: var(--radius-lg) var(--radius-lg) 0 0; }
      .modal-name { font-size: 22px; }
      .floating-wa { bottom: 20px; right: 20px; }
    }

    /* Loading shimmer */
    @keyframes shimmer {
      0% { background-position: -400px 0; }
      100% { background-position: 400px 0; }
    }
    .shimmer {
      background: linear-gradient(90deg, var(--sand) 0px, var(--blush) 80px, var(--sand) 160px);
      background-size: 400px;
      animation: shimmer 1.4s infinite linear;
    }
  </style>
</head>
