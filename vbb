// ── RENDER MAIS VENDIDOS ──
function renderMaisVendidos() {
  const grid = document.getElementById('maisVendidosGrid');
  const mvs = products.filter(p => p.maisVendido);
  grid.innerHTML = mvs.map((p, i) => `
    <div class="mv-card reveal reveal-delay-${i % 4}" onclick="openModal(${p.id})">
      <div class="mv-rank">${i+1}</div>
      <div class="mv-img">${p.emoji}</div>
      <div class="mv-info">
        <div class="mv-name">${p.name}</div>
        <div class="mv-price">${p.price}</div>
      </div>
    </div>
  `).join('');
  observeReveal();
}

// ── FILTER ──
function filterByCategory(cat) {
  activeFilter = cat;
  renderFilterBar();
  renderProducts(cat);
}

// ── MODAL ──
function openModal(id) {
  const p = products.find(x => x.id === id);
  if (!p) return;
  document.getElementById('modalEmoji').textContent = p.emoji;
  document.getElementById('modalCat').textContent = p.cat;
  document.getElementById('modalName').textContent = p.name;
  document.getElementById('modalDesc').textContent = p.desc;
  document.getElementById('modalPrice').textContent = p.price;
  document.getElementById('modalPriceOld').textContent = p.priceOld || '';
  document.getElementById('modalWaBtn').href = buildWaLink(p.name);
  document.getElementById('modalOverlay').classList.add('open');
  document.body.style.overflow = 'hidden';
}
function closeModal(e) {
  if (e.target === document.getElementById('modalOverlay')) {
    closeModalBtn();
  }
}
function closeModalBtn() {
  document.getElementById('modalOverlay').classList.remove('open');
  document.body.style.overflow = '';
}

// ── SEARCH ──
function renderSearchResults(query, inputEl, dropdownEl) {
  if (!query || query.length < 2) { dropdownEl.classList.remove('active'); return; }
  const results = products.filter(p => p.name.toLowerCase().includes(query.toLowerCase()) || p.cat.toLowerCase().includes(query.toLowerCase()));
  if (!results.length) { dropdownEl.innerHTML = '<div class="search-result-item"><div class="search-result-name">Nenhum produto encontrado</div></div>'; dropdownEl.classList.add('active'); return; }
  dropdownEl.innerHTML = results.slice(0, 6).map(p => `
    <div class="search-result-item" onclick="openModal(${p.id}); document.getElementById('${inputEl.id}').value=''; document.getElementById('${dropdownEl.id}').classList.remove('active');">
      <div class="search-result-img">${p.emoji}</div>
      <div>
        <div class="search-result-name">${p.name}</div>
        <div class="search-result-price">${p.price}</div>
      </div>
    </div>
  `).join('');
  dropdownEl.classList.add('active');
}

// ── WHATSAPP LINKS ──
function setAllWaLinks() {
  const generalLink = buildWaLink('');
  const ids = ['headerWaBtn','heroWaBtn','ctaWaBtn','footerWaBtn','floatingWa','mobileMenuWa'];
  ids.forEach(id => {
    const el = document.getElementById(id);
    if (el) el.href = generalLink;
  });
}

// ── SCROLL REVEAL ──
function observeReveal() {
  const els = document.querySelectorAll('.reveal:not(.visible)');
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); }
    });
  }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
  els.forEach(el => obs.observe(el));
}

// ── HEADER SCROLL ──
window.addEventListener('scroll', () => {
  document.getElementById('header').classList.toggle('scrolled', window.scrollY > 20);
});

// ── HAMBURGER ──
document.getElementById('hamburger').addEventListener('click', () => {
  const hb = document.getElementById('hamburger');
  const mm = document.getElementById('mobileMenu');
  hb.classList.toggle('open');
  mm.classList.toggle('open');
  document.body.style.overflow = mm.classList.contains('open') ? 'hidden' : '';
});
function closeMobileMenu() {
  document.getElementById('hamburger').classList.remove('open');
  document.getElementById('mobileMenu').classList.remove('open');
  document.body.style.overflow = '';
}

// ── SEARCH SETUP ──
function setupSearch() {
  // Desktop (only show if viewport wide enough)
  const sw = document.getElementById('searchWrapDesktop');
  if (window.innerWidth >= 641) sw.style.display = 'block';

  const inp = document.getElementById('searchInputDesktop');
  const drop = document.getElementById('searchDropdownDesktop');
  inp.addEventListener('input', () => renderSearchResults(inp.value, inp, drop));
  document.addEventListener('click', e => { if (!sw.contains(e.target)) drop.classList.remove('active'); });
}

// ── INIT ──
document.addEventListener('DOMContentLoaded', () => {
  renderCategories();
  renderFilterBar();
  renderProducts('Todos');
  renderNovidades();
  renderMaisVendidos();
  setAllWaLinks();
  observeReveal();
  setupSearch();

  // Trigger initial reveals
  setTimeout(observeReveal, 100);
});
