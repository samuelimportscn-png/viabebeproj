let activeFilter = 'Todos';

// ── RENDER CATEGORIES ──
function renderCategories() {
  const grid = document.getElementById('categoriesGrid');
  grid.innerHTML = categories.map(cat => `
    <a class="cat-card reveal" href="#produtos" onclick="filterByCategory('${cat.name}')">
      <span class="cat-icon">${cat.emoji}</span>
      <div class="cat-name">${cat.name}</div>
      <div class="cat-count">${cat.count} produtos</div>
    </a>
  `).join('');
  observeReveal();
}

// ── RENDER FILTER BAR ──
function renderFilterBar() {
  const bar = document.getElementById('filterBar');
  const cats = ['Todos', ...categories.map(c=>c.name)];
  bar.innerHTML = cats.map(cat => `
    <button class="filter-btn ${cat === activeFilter ? 'active' : ''}" onclick="filterByCategory('${cat}')">${cat}</button>
  `).join('');
}

